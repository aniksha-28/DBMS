-- =====================================================
-- 3. NORMALISED TABLES (3NF / BCNF)
-- =====================================================

-- 3.1 CUSTOMER

CREATE TABLE CUSTOMER (
    CustomerID VARCHAR(10) PRIMARY KEY,
    CustomerName VARCHAR(100) NOT NULL,
    CustomerEmail VARCHAR(100) UNIQUE NOT NULL
);

-- 3.2 SUPPLIER

CREATE TABLE SUPPLIER (
    SupplierID VARCHAR(10) PRIMARY KEY,
    SupplierName VARCHAR(100) NOT NULL,
    SupplierPhone VARCHAR(20) UNIQUE
);

-- 3.3 CATEGORY

CREATE TABLE CATEGORY (
    CategoryID VARCHAR(10) PRIMARY KEY,
    CategoryName VARCHAR(50) NOT NULL
);

-- 3.4 WAREHOUSE

CREATE TABLE WAREHOUSE (
    WarehouseID VARCHAR(10) PRIMARY KEY,
    WarehouseCity VARCHAR(50) NOT NULL
);

-- 3.5 POSTAL

CREATE TABLE POSTAL (
    ShipPIN VARCHAR(10) PRIMARY KEY,
    ShipCity VARCHAR(50) NOT NULL,
    ShipState VARCHAR(50) NOT NULL
);

-- 3.6 PRODUCT

CREATE TABLE PRODUCT (
    ProductID VARCHAR(10) PRIMARY KEY,
    ProductName VARCHAR(100) NOT NULL,
    UnitPrice DECIMAL(10,2) NOT NULL
        CHECK (UnitPrice >= 0),
    CategoryID VARCHAR(10) NOT NULL,
    SupplierID VARCHAR(10) NOT NULL,

    FOREIGN KEY (CategoryID)
        REFERENCES CATEGORY(CategoryID),

    FOREIGN KEY (SupplierID)
        REFERENCES SUPPLIER(SupplierID)
);

-- 3.7 ORDERS

CREATE TABLE ORDERS (
    OrderID VARCHAR(10) PRIMARY KEY,
    OrderDate DATE NOT NULL,
    CustomerID VARCHAR(10) NOT NULL,
    ShipStreet VARCHAR(100) NOT NULL,
    ShipPIN VARCHAR(10) NOT NULL,

    FOREIGN KEY (CustomerID)
        REFERENCES CUSTOMER(CustomerID),

    FOREIGN KEY (ShipPIN)
        REFERENCES POSTAL(ShipPIN)
);

-- 3.8 ORDER_ITEM

CREATE TABLE ORDER_ITEM (
    OrderID VARCHAR(10),
    ProductID VARCHAR(10),
    Quantity INT NOT NULL CHECK (Quantity > 0),
    WarehouseID VARCHAR(10) NOT NULL,

    PRIMARY KEY (OrderID, ProductID),

    FOREIGN KEY (OrderID)
        REFERENCES ORDERS(OrderID),

    FOREIGN KEY (ProductID)
        REFERENCES PRODUCT(ProductID),

    FOREIGN KEY (WarehouseID)
        REFERENCES WAREHOUSE(WarehouseID)
);

-- 3.9 STREET_POSTAL

CREATE TABLE STREET_POSTAL (
    ShipStreet VARCHAR(100),
    ShipCity VARCHAR(50),
    ShipPIN VARCHAR(10) NOT NULL,

    PRIMARY KEY (ShipStreet, ShipCity),

    FOREIGN KEY (ShipPIN)
        REFERENCES POSTAL(ShipPIN)
);


-- =====================================================
-- 4. FOURTH NORMAL FORM (4NF)
-- =====================================================

-- 4.1 PRODUCT_TAG

CREATE TABLE PRODUCT_TAG (
    ProductID VARCHAR(10),
    Tag VARCHAR(50),

    PRIMARY KEY (ProductID, Tag),

    FOREIGN KEY (ProductID)
        REFERENCES PRODUCT(ProductID)
);

-- 4.2 PRODUCT_COLOUR

CREATE TABLE PRODUCT_COLOUR (
    ProductID VARCHAR(10),
    Colour VARCHAR(30),

    PRIMARY KEY (ProductID, Colour),

    FOREIGN KEY (ProductID)
        REFERENCES PRODUCT(ProductID)
);


-- =====================================================
-- 5. FIFTH NORMAL FORM (5NF)
-- =====================================================

-- 5.1 SUPPLIER_CATEGORY

CREATE TABLE SUPPLIER_CATEGORY (
    SupplierID VARCHAR(10),
    CategoryID VARCHAR(10),

    PRIMARY KEY (SupplierID, CategoryID),

    FOREIGN KEY (SupplierID)
        REFERENCES SUPPLIER(SupplierID),

    FOREIGN KEY (CategoryID)
        REFERENCES CATEGORY(CategoryID)
);

-- 5.2 CATEGORY_WAREHOUSE

CREATE TABLE CATEGORY_WAREHOUSE (
    CategoryID VARCHAR(10),
    WarehouseID VARCHAR(10),

    PRIMARY KEY (CategoryID, WarehouseID),

    FOREIGN KEY (CategoryID)
        REFERENCES CATEGORY(CategoryID),

    FOREIGN KEY (WarehouseID)
        REFERENCES WAREHOUSE(WarehouseID)
);

-- 5.3 SUPPLIER_WAREHOUSE

CREATE TABLE SUPPLIER_WAREHOUSE (
    SupplierID VARCHAR(10),
    WarehouseID VARCHAR(10),

    PRIMARY KEY (SupplierID, WarehouseID),

    FOREIGN KEY (SupplierID)
        REFERENCES SUPPLIER(SupplierID),

    FOREIGN KEY (WarehouseID)
        REFERENCES WAREHOUSE(WarehouseID)
);


