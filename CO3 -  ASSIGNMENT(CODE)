-- =====================================================
-- 8. ORDER HISTORY USING FIVE TABLES (JOIN)
-- =====================================================

SELECT
    O.OrderID,
    O.OrderDate,
    C.CustomerName,
    P.ProductName,
    I.Quantity,
    W.WarehouseCity
FROM ORDERS O
JOIN CUSTOMER C
    ON O.CustomerID = C.CustomerID
JOIN ORDER_ITEM I
    ON O.OrderID = I.OrderID
JOIN PRODUCT P
    ON I.ProductID = P.ProductID
JOIN WAREHOUSE W
    ON I.WarehouseID = W.WarehouseID;


